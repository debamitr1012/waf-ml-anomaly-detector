# Environment Configuration
# Copy this file to .env and update values

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Dashboard Settings
DASHBOARD_PORT=5000
SECRET_KEY=change-this-in-production-to-a-random-string

# Admin Credentials (CHANGE IN PRODUCTION!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Database
DATABASE_URL=sqlite:///waf_ml.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/waf_ml_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO

# ML Settings
MODEL_DIR=models
RETRAIN_INTERVAL_HOURS=24

# Performance
MAX_CONCURRENT_ANALYSES=100
REQUEST_TIMEOUT_SECONDS=30

# Debug (set to False in production)
DEBUG=False
